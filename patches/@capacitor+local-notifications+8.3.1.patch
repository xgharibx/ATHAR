+        let item: [String: Any] = [
+            "id": UUID().uuidString,
+            "actionId": actionId,
+            "extra": extra,
+            "title": request.content.title,
+            "body": request.content.body,
+            "handled": handled,
+            "at": Date().timeIntervalSince1970 * 1000,
+        ]
+        guard let data = try? JSONSerialization.data(withJSONObject: item),
+              let text = String(data: data, encoding: .utf8) else { return }
+        var queue = UserDefaults.standard.stringArray(forKey: queueKey) ?? []
+        queue.append(text)
+        UserDefaults.standard.set(Array(queue.suffix(50)), forKey: queueKey)
+    }
+
+    /// The same snooze the app would schedule: the same id, so it is replaced, not doubled.
+    private static func snooze(_ actionId: String, _ request: UNNotificationRequest, _ extra: [String: Any]) -> Bool {
+        guard let content = request.content.mutableCopy() as? UNMutableNotificationContent else { return false }
+        let identifier: String
+        let minutes: Int
+        if actionId == "snooze_60" {
+            guard let key = extra["reminderKey"] as? String, let id = reminderSnoozeIds[key] else { return false }
+            identifier = String(id)
+            minutes = 60
+        } else {
+            guard let reminderId = extra["reminderId"] as? String else { return false }
+            let wanted = (extra["snoozeMinutes"] as? NSNumber)?.intValue ?? 10
+            minutes = customSnoozeMinutes.contains(wanted) ? wanted : 10
+            let fireAt = Int64((Date().timeIntervalSince1970 * 1000).rounded()) + Int64(minutes) * 60_000
+            let owner = extra["accountOwner"] as? String ?? "local"
+            var allowed = CharacterSet.alphanumerics
+            allowed.insert(charactersIn: "-_.!~*'()")
+            let ownerPart = owner == "local" ? "" : "\(owner.addingPercentEncoding(withAllowedCharacters: allowed) ?? owner):"
+            identifier = String(fnv1a("cr:\(ownerPart)\(reminderId):\(fireAt)"))
+        }
+        content.sound = nil
+        let trigger = UNTimeIntervalNotificationTrigger(timeInterval: TimeInterval(minutes * 60), repeats: false)
+        UNUserNotificationCenter.current().add(UNNotificationRequest(identifier: identifier, content: content, trigger: trigger))
+        return true
+    }
+
+    /// numericIdFor() in src/lib/customReminderNotifications.ts.
+    private static func fnv1a(_ text: String) -> UInt32 {
+        var hash: UInt32 = 2_166_136_261
+        for unit in text.utf16 {
+            hash ^= UInt32(unit)
+            hash = hash &* 16_777_619
+        }
+        return hash % 0x7fff_ffff
+    }
+}
