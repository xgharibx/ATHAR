<?xml version="1.0" encoding="utf-8"?>
<!-- Qadaa board widget — 4×2 default, resizable -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_qadaa_board"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="210dp"
    android:minResizeHeight="200dp"
    android:previewLayout="@layout/widget_qadaa_board"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:configure="com.athar.adhkar.WidgetConfigActivity"
    android:description="@string/widget_qadaa_board_description" />
