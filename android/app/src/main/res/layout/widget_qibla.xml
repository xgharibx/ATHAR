<?xml version="1.0" encoding="utf-8"?>
<!--
  Qibla Direction Widget (2×2) — Athar premium design
  Static compass dial (Canvas bitmap) pointing at the Kaaba bearing,
  computed from the same last-known location the app already caches.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qibla_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/noor_widget_background">

    <ImageView
        android:id="@+id/qibla_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <!-- Animated starfield: a ViewFlipper animates in the LAUNCHER's process
         (a widget has no animation loop of its own), cross-fading these
         frames forever and stopping itself when the home screen is hidden.
         See res/anim/widget_star_in.xml and WidgetStars.java. -->
    <ViewFlipper
        android:id="@+id/qibla_stars_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="2600"
        android:inAnimation="@anim/widget_star_in"
        android:outAnimation="@anim/widget_star_out"
        android:importantForAccessibility="no">
        <ImageView
            android:id="@+id/qibla_stars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/qibla_stars_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/qibla_stars_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center">

        <TextView
            android:id="@+id/qibla_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="القبلة"
            android:textColor="@color/widget_text_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/qibla_arrow"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/qibla_bearing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qibla_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="افتح التطبيق"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/qibla_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />

    </LinearLayout>

</FrameLayout>
