<?xml version="1.0" encoding="utf-8"?>
<!--
  Outgoing starfield frame — see widget_star_in.xml for why the launcher, not
  the app, drives this. The outgoing frame keeps drifting in the SAME
  direction as the incoming one, and starts exactly where the incoming frame
  ended, so the two cross-fade into one continuous sweep rather than visibly
  swapping places.

  Fades out slower than the incoming frame fades in, so the sky never dips
  toward empty mid-transition (both frames are partly visible at the crossover,
  which is what sells it as one moving field instead of two slides).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="1150"
        android:interpolator="@android:anim/accelerate_decelerate_interpolator" />

    <translate
        android:fromYDelta="-2.5%"
        android:toYDelta="-11.5%"
        android:fromXDelta="-1.2%"
        android:toXDelta="-5.9%"
        android:duration="1400"
        android:interpolator="@android:anim/linear_interpolator" />
</set>
