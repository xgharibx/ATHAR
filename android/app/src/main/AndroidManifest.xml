<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          The app's one activity. The launcher icon is not declared here but on
          the activity-aliases below, so the icon can be changed from Settings
          (AppIconPlugin) without a second launcher entry.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".AtharActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">


            <!-- OAuth return leg. Google will not render its consent screen
                 inside a WebView, so sign-in opens the system browser; this
                 custom scheme is how the browser hands the session back to the
                 app. Must stay in sync with NATIVE_AUTH_REDIRECT in
                 src/lib/authClient.ts and the Supabase redirect allow-list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.athar" android:host="auth" />
            </intent-filter>
            <!-- Return-to-Athar link from the public /feedback page.
                 Keep separate from OAuth (auth host) to avoid launching auth on return. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.athar" android:host="open" />
            </intent-filter>

        </activity>

        <!-- The default icon. Keeps the original launcher component name, so icons already on people's home screens stay put after the update. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".AtharActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Alternate icon: light (Settings › أيقونة التطبيق). -->
        <activity-alias
            android:name=".MainActivityLight"
            android:targetActivity=".AtharActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Alternate icon: dark (Settings › أيقونة التطبيق). -->
        <activity-alias
            android:name=".MainActivityDark"
            android:targetActivity=".AtharActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Alternate icon: ramadan (Settings › أيقونة التطبيق). -->
        <activity-alias
            android:name=".MainActivityRamadan"
            android:targetActivity=".AtharActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ramadan"
            android:roundIcon="@mipmap/ic_launcher_ramadan_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Alternate icon: gold (Settings › أيقونة التطبيق). -->
        <activity-alias
            android:name=".MainActivityGold"
            android:targetActivity=".AtharActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gold"
            android:roundIcon="@mipmap/ic_launcher_gold_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Widget theme picker — shown when any Athar widget is placed
             (referenced by android:configure in every widget info.xml). -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Next-prayer countdown: moves on at the adhan, remembers a swipe-away. -->
        <receiver
            android:name=".PrayerCountdownReceiver"
            android:exported="false" />

        <!-- Native Quran recitation: media playback foreground service (Media3). -->
        <service
            android:name=".RecitationService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Prayer Times Widget (4×3) -->
        <receiver
            android:name=".NoorPrayerFullWidgetProvider"
            android:exported="true"
            android:label="@string/widget_prayer_full_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_full_info" />
        </receiver>
        <!-- Daily Adhkar Progress Widget (4×2) -->
        <receiver
            android:name=".NoorAdhkarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_adhkar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_adhkar_info" />
        </receiver>
        <!-- Quran Wird Progress Widget (4×2) -->
        <receiver
            android:name=".NoorWirdWidgetProvider"
            android:exported="true"
            android:label="@string/widget_wird_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wird_info" />
        </receiver>
        <!-- Daily Dashboard Widget (4×4) -->
        <receiver
            android:name=".NoorDashboardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_dashboard_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dashboard_info" />
        </receiver>

        <!-- Internal endpoint for taps on the interactive widget controls -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />

        <!-- Compact Daily Widget (2×1) -->
        <receiver
            android:name=".NoorCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/noor_widget_compact_info" />
        </receiver>

        <!-- Prayer Countdown Widget (4×2) -->
        <receiver
            android:name=".NoorPrayerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_prayer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/noor_widget_prayer_info" />
        </receiver>

        <!-- Sunnah Widget (4×2) -->
        <receiver
            android:name=".NoorSunnahWidgetProvider"
            android:exported="true"
            android:label="@string/widget_sunnah_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/noor_widget_sunnah_info" />
        </receiver>

        <!-- Interactive Tasbeeh Widget (2×2) -->
        <receiver
            android:name=".NoorTasbeehWidgetProvider"
            android:exported="true"
            android:label="@string/widget_tasbeeh_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/noor_widget_tasbeeh_info" />
        </receiver>

        <!-- Asma al-Husna Daily Widget (4×2) -->
        <receiver
            android:name=".NoorAsmaWidgetProvider"
            android:exported="true"
            android:label="@string/widget_asma_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_asma_info" />
        </receiver>

        <!-- Qibla Direction Widget (2×2) -->
        <receiver
            android:name=".NoorQiblaWidgetProvider"
            android:exported="true"
            android:label="@string/widget_qibla_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_qibla_info" />
        </receiver>

        <!-- Qadaa Widget (4×2) -->
        <receiver
            android:name=".NoorQadaaWidgetProvider"
            android:exported="true"
            android:label="@string/widget_qadaa_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_qadaa_info" />
        </receiver>
        <!-- Qadaa Board Widget (4×3, interactive) -->
        <receiver
            android:name=".NoorQadaaBoardWidgetProvider"
            android:exported="true"
            android:label="@string/widget_qadaa_board_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_qadaa_board_info" />
        </receiver>
        <!-- Wird Table Widget (4×2) -->
        <receiver
            android:name=".NoorWirdTableWidgetProvider"
            android:exported="true"
            android:label="@string/widget_wirdtable_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wirdtable_info" />
        </receiver>
        <!-- The Adhan as a real alarm (AdhanAlarm): rings on silent, Stop screen over the lock screen. -->
        <receiver
            android:name=".AdhanAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".AdhanAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".AdhanAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
        <!-- Quick Settings tiles: the next prayer, and the tasbeeh counter. -->
        <service
            android:name=".PrayerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_prayer"
            android:label="@string/tile_prayer_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".SebhaTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_sebha"
            android:label="@string/tile_sebha_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Prayer times, Qibla, and nearby mosques -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Local Notifications -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Quran recitation and the radio keep playing with the screen off through
         a media playback foreground service (Android 14+ requires this type). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Public MediaStore writes need this only on Android 9 and below. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Sebha voice counting -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The Adhan alarm's Stop screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Android 11+: lets the app find the phone's speech recogniser for voice tasbeeh. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
