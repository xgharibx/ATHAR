{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "./node_modules/.tsc-node-cache",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "vite.config.ts",
    "capacitor.config.ts",
    "tools/build/hardenHtml.ts",
    "tools/build/thirdPartyNotices.ts"
  ]
}
