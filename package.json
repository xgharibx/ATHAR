{
  "name": "athar-adhkar",
  "private": true,
  "version": "1.2.91",
  "released": {
    "android": "1.2.82",
    "ios": null,
    "huawei": null
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "description": "ATHAR — The ultimate Adhkar experience (PWA + Android & iOS-ready via Capacitor).",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Amr Abdel-Aziz Gharib (https://www.athark.org)",
  "homepage": "https://www.athark.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xgharibx/ATHAR.git"
  },
  "bugs": {
    "url": "https://www.athark.org/support.html",
    "email": "amr@gharib.dev"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src supabase/functions vite.config.ts capacitor.config.ts",
    "test": "vitest run",
    "verify": "npm run support:check && npm run android:check-target && npm run capacitor:check-security && npm run lint && npm run test && npm run build",
    "release:web": "npm run verify",
    "release:web:auto-icon": "node tools/scripts/release-web.mjs",
    "leaderboard:health": "node tools/backend/check-leaderboard-endpoint.mjs",
    "format": "prettier -w .",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android": "npm run build && npm run android:sync && npm run android:open",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios": "npm run build && npm run ios:sync && npm run ios:open",
    "version:bump": "node tools/scripts/bump-version.mjs",
    "version:check": "node tools/scripts/bump-version.mjs --check",
    "release:play": "node tools/scripts/build-store.mjs --store=play",
    "release:huawei": "node tools/scripts/build-store.mjs --store=huawei",
    "release:stores": "node tools/scripts/build-store.mjs --store=all",
    "postinstall": "node tools/scripts/patch-capacitor-plugins.mjs",
    "support:check": "node tools/scripts/check-support-page.mjs",
    "android:check-target": "node tools/scripts/check-android-target-sdk.mjs",
    "capacitor:check-security": "node tools/scripts/check-capacitor-security.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@react-three/drei": "^9.112.1",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.51.24",
    "@tsparticles/engine": "^4.5.4",
    "@tsparticles/react": "^4.5.4",
    "@tsparticles/slim": "^4.5.4",
    "@types/three": "^0.187.0",
    "adhan": "^4.4.4",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "dexie": "^4.4.2",
    "framer-motion": "^11.3.12",
    "fuse.js": "^7.0.0",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "html-to-image": "^1.11.11",
    "lenis": "^1.3.23",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.451.0",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-type-animation": "^3.2.0",
    "react-virtuoso": "^4.18.22",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.2",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "^7.5.22"
    }
  }
}
