default_platform(:ios)

# Uses the App Store Connect API key written by .github/workflows/ios-metadata.yml:
#   APPSTORE_KEY_ID, APPSTORE_ISSUER_ID and the key file path in APPSTORE_KEY_PATH.
platform :ios do
  desc "Upload the store listing text and screenshots (no binary, not submitted for review)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_filepath: ENV["APPSTORE_KEY_PATH"]
    )
    deliver(
      api_key: api_key,
      app_identifier: "com.athar.adhkar",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_app_version_update: false,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      overwrite_screenshots: true
    )
  end
end
