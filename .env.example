# ATHAR environment template
# انسخ هذا الملف إلى .env.local ثم عدّل القيم حسب بيئتك.

# Leaderboard API endpoint (Supabase Edge Function)
# مثال:
# VITE_LEADERBOARD_ENDPOINT=https://<project-ref>.functions.supabase.co/leaderboard
VITE_LEADERBOARD_ENDPOINT=

# Optional: required if your endpoint gateway enforces apikey/jwt for Edge Functions
VITE_LEADERBOARD_ANON_KEY=

# IMPORTANT:
# Do NOT put LEADERBOARD_ADMIN_TOKEN here.
# Keep the admin token only in Supabase Edge Function secrets,
# then paste it manually inside the in-app admin panel when needed.

# رفيق أثر — AI companion.
# نقطة واحدة فقط لكل المستخدمين، تعمل بـ MiniMax M3 حصريًا من جهة الخادم.
# يجب تسجيل الدخول بحساب أثر لاستعمال الذكاء الاصطناعي؛ يبقى باقي التطبيق
# متاحًا للضيف. تُرسل apikey بالمفتاح العام وAuthorization برمز جلسة المستخدم.
# إعدادات الواجهة:
#   VITE_COMPANION_PROXY_URL = Supabase Edge Function companion URL
#   VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY = إعداد تسجيل الدخول أدناه
#   أو VITE_LEADERBOARD_ANON_KEY كمفتاح عام بديل للبوابة.
# مثال:
# VITE_COMPANION_PROXY_URL=https://<project-ref>.functions.supabase.co/companion
VITE_COMPANION_PROXY_URL=

# IMPORTANT:
# مفتاح MiniMax_API_KEY يجب أن يبقى داخل Supabase Edge Function secrets فقط:
#   npx supabase secrets set MINIMAX_API_KEY=…
# لا تضعه هنا — أي مفتاح في VITE_* ينتهي محروقًا داخل حزمة المتصفح.

# Optional: bump this value on release to force icon refresh for installed PWA clients
# Example: VITE_ICON_REV=2026-02-14-r2
VITE_ICON_REV=

# Optional: runtime stamp used to force a soft reload once per release (set automatically in CI)
# Example: VITE_RUNTIME_VERSION=git-sha-or-release-tag
VITE_RUNTIME_VERSION=

# --- Accounts, cloud sync & Companion AI ---
# Until BOTH are set the account UI stays hidden; local Quran and adhkar
# features remain available, but Companion AI replies require a signed-in user.
# See docs/ACCOUNTS_SETUP.md.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
